@startuml lighting-service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.14.0/C4_Component.puml

title lighting-service: диаграмма компонентов

Container(web, "web-приложение", "spa")
Container(device_svc, "device-service", "go")

Container_Boundary(svc, "lighting-service") {
    Component(api, "rest api", "go", "/lighting/{deviceId}/power, /lighting/{deviceId}/brightness")
    Component(lighting, "LightingService", "go", "включение, выключение и яркость, проверяет, что устройство относится к освещению")
    Component(client, "DeviceClient", "go", "GET /devices/{id}, PATCH /devices/{id}/state, POST /devices/{id}/commands")
}

Rel(web, api, "управление освещением", "rest")
Rel(api, lighting, "вызывает")
Rel(lighting, client, "проверка устройства, состояние, команды")
Rel(client, device_svc, "rest")

SHOW_LEGEND()
@enduml
